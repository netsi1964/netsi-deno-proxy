{
  "name": "netsi-deno-proxy",
  "version": "1.0.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env main.ts",
    "start": "deno run --allow-net --allow-env main.ts",
    "check": "deno check main.ts && deno lint && deno fmt --check",
    "skill": "rm -f netsi-proxy.skill && cd .claude/skills && zip -rXq ../../netsi-proxy.skill netsi-proxy -x '*.DS_Store'"
  },
  "deploy": {
    "entrypoint": "main.ts",
    "org": "netsi1964",
    "app": "netsi-proxy-deno"
  },
  "fmt": {
    "lineWidth": 90,
    "exclude": [".claude"]
  }
}
